#!/bin/sh

if [ "$PULSE_SKIP_POST_COMMIT_PUBLISH" = "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

cd "$REPO_ROOT" || exit 0

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/auto-publish-master.ps1"
